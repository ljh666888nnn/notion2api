# ==========================================
# Notion-AI Configuration Template / 
# Copy this file to .env and fill in actual values /  .env 
# ==========================================

# ----------------------------------------------------------
# 1. Core Credentials: Notion Account Pool (JSON Array Format)
#    Notion JSON 
# ----------------------------------------------------------
# Must include: token_v2, space_id, user_id / token_v2, space_id, user_id
# accounts.json takes precedence; this variable is only used when the file is absent.
#  accounts.json
# Multiple accounts can be used for normal load distribution / 
#
# Recommended: run `python login.py` to launch Chrome, capture the active
# Notion session locally, and update accounts.json/.env automatically.
#  `python login.py` Chrome Notion
#  accounts.json/.env
#
# Legacy manual fallback: copy token_v2 from DevTools, then run
# scripts/extract_notion_info.js in the browser console to get the other fields.
#  DevTools  token_v2 Console 
# scripts/extract_notion_info.js 
# ----------------------------------------------------------
NOTION_ACCOUNTS='[{"profile_name":"default","token_v2":"your_token","space_id":"your_space","user_id":"your_uid","space_view_id":"your_view","user_name":"your_name","user_email":"your_email"}]'

# ----------------------------------------------------------
# 2. FastAPI Service & Security / FastAPI 
# ----------------------------------------------------------
# API_KEY: Bearer Token for /v1 requests, including account admin endpoints
#           /v1  Bearer Token
#          If empty, admin endpoints return 403 instead of becoming public.
#           403
# Leave empty to disable auth (not recommended for production) / 
API_KEY=

# HOST: Service binding IP. 0.0.0.0 allows external network access
#        IP0.0.0.0 
HOST=0.0.0.0

# ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS.
#                  Use "*" to allow all origins (not recommended for production).
#                  CORS "*" 
ALLOWED_ORIGINS=*

PORT=8000

# APP_MODE: Application
# - standard: Full context, supports thinking & search, no database (default, recommended) /  thinking 
# - lite: Single-turn Q&A, no memory, no database / 
# - heavy: Full session management, requires SQLite + SILICONFLOW_API_KEY /  SQLite + SILICONFLOW_API_KEY
APP_MODE=standard

# ----------------------------------------------------------
# 3. Data Persistence (SQLite) / SQLite
# ----------------------------------------------------------
# DB_PATH: Chat history database file path / 
# For local development, use relative path: ./data/conversations.db / ./data/conversations.db
DB_PATH=./data/conversations.db

# Account pool strategy / 
# round_robin: rotate in order / 
# weighted_round_robin: smooth weighted rotation using each account's weight
#                        weight 
# least_recently_used: prefer the account used least recently / 
# least_inflight: prefer the account with the fewest active requests
#                 
# fastest: health first, then lowest inflight, then lowest EWMA latency
# also: round_robin | weighted_round_robin | least_recently_used | least_inflight
ACCOUNT_POOL_STRATEGY=fastest

# Base cooldown and exponential backoff cap for failed accounts (seconds)
# 
ACCOUNT_COOLDOWN_SECONDS=3
ACCOUNT_MAX_COOLDOWN_SECONDS=60

# Maximum time a request waits when all accounts are cooling (seconds)
#  503
ACCOUNT_POOL_MAX_WAIT_SECONDS=15

# Pool-wide concurrency cap per account. 0 means unlimited.
# Per-account max_concurrency in accounts.json overrides this value.
# 0  max_concurrency 
ACCOUNT_MAX_CONCURRENCY=0

# Random jitter applied to exponential cooldown (0.0-1.0)
# 
ACCOUNT_COOLDOWN_JITTER_RATIO=0.15

# ----------------------------------------------------------
# 5. Advanced Configuration (Optional) / 
# ----------------------------------------------------------
# SILICONFLOW_API_KEY: For SiliconFlow service (backup solution) /  SiliconFlow 
SILICONFLOW_API_KEY=

# NOTION_CLIENT_VERSION: Override Notion client version header if Notion updates their API
#                        Notion Notion 
# NOTION_CLIENT_VERSION=23.13.20260228.0625

# NOTION_URL: Notion site base URL (regional mirror / reverse proxy). Default official site.
#             Notion 
# NOTION_URL=https://www.notion.so
#
# NOTION_DOMAIN: Cookie domain for login.py. Default: www.notion.so
#                login.py  cookie  domain
# NOTION_DOMAIN=www.notion.so

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL / 
LOG_LEVEL=INFO

# Timezone / 
TZ=Asia/Shanghai

NOTION_CLIENT_VERSION=23.13.20261022.1056

# ----------------------------------------------------------
# 6. Function Calling & MCP
# ----------------------------------------------------------
# IMPORTANT: keep this file pure ASCII.
# slowapi builds a starlette Config on ".env" using the platform default
# encoding (GBK on Chinese Windows). A single non-ASCII byte in .env makes
# Limiter() raise UnicodeDecodeError and the whole service fails to start.
# Keep comments in English; put non-ASCII text in docs, not in .env.
#
# TOOL_BRIDGE: render client `tools` into the prompt, and convert the model's
#   <tool_call>{...}</tool_call> back into standard OpenAI tool_calls
#   (streaming and non-streaming). Off by default.
TOOL_BRIDGE=1
# TOOL_BRIDGE_FRAME: how the catalogue is worded when TOOL_BRIDGE=1.
#   catalogue (default): "functions available in this session"
#                        -> the upstream model refuses: "these are not my tools"
#   planner: "an external executor provides these; you only write the call"
#            -> measured compliant (see docs/AGENT_FEASIBILITY.md)
TOOL_BRIDGE_FRAME=planner
# NOTION_CONTEXT_BLOCK: send the Notion `context` block (userId/spaceId/timezone).
#   Default 1. Set 0 for agent/tool workloads: with the full config, the context
#   block anchors the session to Notion's workspace and the model refuses
#   external tool calls. Chat-only workloads can keep it.
NOTION_CONTEXT_BLOCK=0
# NOTION_SYSTEM_MODE: how the client system prompt is handled.
#   neutral (default) strip role assertions ("You are a coding agent ...") and
#                     prepend a third-person background line. If the text carries
#                     policy-override wording (UNRESTRICTED SANDBOX / never refuse
#                     / jailbreak), the whole system prompt is replaced by that
#                     neutral line -- otherwise the upstream refuses the request.
#   strip             strip role assertions only, keep override wording as-is
#   raw               legacy allowlist-only stripping
#   off               do not send any system text
# NOTION_SYSTEM_MODE=neutral

# Upstream input budget, measured in JSON-escaped UTF-8 bytes (default 195000).
#   Oversized tool results are compressed to head+tail; if still over, the oldest
#   messages are dropped; if nothing is left to drop the request fails with
#   413 CONTEXT_TOO_LARGE instead of an opaque upstream 502.
# NOTION_INPUT_MAX_BYTES=195000
# NOTION_TOOL_RESULT_MAX_CHARS=16000

# SSE keepalive comment (`: keepalive`) while the upstream is silent, in seconds.
#   0 disables. Notion can think for 40-50s before the first byte.
# SSE_HEARTBEAT_SECONDS=15

# Image handling for /v1/messages and /v1/responses.
#   vision (default) transcribe the image with a local multimodal model, then
#                    inject the description as text (upstream cannot see files)
#   omit             replace with "[image omitted]" and continue
#   reject           return 415 with an explanation
# NOTION_IMAGE_MODE=vision
#
# Local multimodal gateway used by `vision` (OpenAI compatible).
# VISION_BASE=http://127.0.0.1:8788/v1
# VISION_MODEL=hy4-preview
# VISION_KEY=any-key
# VISION_TIMEOUT=60

# MCP_ENABLED: mount POST /mcp (JSON-RPC 2.0, Streamable HTTP).
#   Tools are executed locally by the gateway, independent of Notion.
MCP_ENABLED=1

# Sandbox root for file tools. Default: project root.
# MCP_ROOT=

# Expose write_file / run_command. Both default off (read-only server).
# MCP_ALLOW_WRITE=0
# MCP_ALLOW_EXEC=0

# Allow paths outside MCP_ROOT (not recommended).
# MCP_ALLOW_OUTSIDE=0

# Max bytes read per read_file call.
# MCP_MAX_READ_BYTES=200000

# ----------------------------------------------------------
# 7. Upstream Agent Capabilities
# ----------------------------------------------------------
# The captured transcript config came from a browser *agent* session, so it
# ships with Notion's computer / script-agent switches ON. Left on, the model
# answers as a sandboxed agent ("/data is empty, I cannot read your local
# path") and ignores any external tool list we inject.
#
# NOTION_AGENT_CAPS=1 restores the original captured behavior (A/B testing).
NOTION_AGENT_CAPS=0

# Override transcript config.type (workflow | markdown-chat). Empty = per model.
# NOTION_THREAD_TYPE=

# Upstream web/workspace search, appends source-citation blocks. Off by default.
NOTION_WEB_SEARCH=0

# Fill space_id/user_id/space_view_id from token_v2 automatically (needs network).
# Set 0 to require all fields explicitly in accounts.json.
# ACCOUNT_AUTODISCOVER=1
